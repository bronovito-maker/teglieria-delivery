# Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# URL e sicurezza applicativa
NEXT_PUBLIC_SITE_URL="https://www.lateglieria.it"
TRUSTED_ORIGINS="https://www.lateglieria.it"
ORDER_STATUS_TOKEN_TTL_SECONDS="172800"
# Default: nuova autenticazione con la password dell'account Admin.
ADMIN_ORDER_DELETE_VERIFICATION_MODE="reauth"
# Solo per ambienti che non possono usare reauth: conservare e ruotare nel vault server-side.
# ADMIN_ORDER_DELETE_PASSWORD="your-rotated-server-side-secret"
CRON_SECRET="set-a-long-random-secret-for-scheduled-feedback-emails"

# Ruoli admin/operator
ADMIN_ALLOWLIST_EMAILS="admin@example.com"
OPERATOR_ALLOWLIST_EMAILS="operatore@example.com"

# Email Brevo
BREVO_API_KEY="your-brevo-api-key"
ORDER_STATUS_WEBHOOK_URL="https://your-automation-webhook-url"

# Google Maps, Places e scheda Google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="your-google-map-id"
NEXT_PUBLIC_GOOGLE_REVIEW_URL="https://g.page/r/CW1blgo1a4szECE/review"
NEXT_PUBLIC_STORE_LAT="43.55"
NEXT_PUBLIC_STORE_LNG="10.33"

# Contatti e canali pubblici opzionali
NEXT_PUBLIC_STORE_PHONE="+39..."
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/..."
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/..."
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Compensi rider
RIDER_COMPENSATION_PER_DELIVERY_EUR="1.80"
RIDER_COMPENSATION_DAILY_FIXED_EUR="0.00"

# Stripe: usare sk_live_ + webhook live in produzione;
# usare sk_test_ + STRIPE_TEST_WEBHOOK_SECRET in Preview/Development.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_TEST_WEBHOOK_SECRET="whsec_..."

# Rate limit distribuito opzionale. Senza questi valori viene usato il fallback
# locale in memoria, adatto allo sviluppo ma non ideale per più istanze.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# E2E opzionali
E2E_BASE_URL="http://localhost:3000"
E2E_CUSTOMER_EMAIL="customer@example.com"
E2E_CUSTOMER_PASSWORD="your-customer-password"
E2E_ADMIN_EMAIL="admin@example.com"
E2E_ADMIN_PASSWORD="your-admin-password"
E2E_RIDER_EMAIL="rider@example.com"
E2E_RIDER_PASSWORD="your-rider-password"
E2E_ALLOW_REGISTRATION="false"
E2E_STRIPE="0"
